{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${extensionPath}/hook-shim.sh\" \"${extensionPath}\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
